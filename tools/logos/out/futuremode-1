<script>
(function(){
  /* =====================  EDIT HERE  ===================== */
  var FM_CONFIG = {
    heroVideo:    "",   // e.g. "https://static1.squarespace.com/static/.../hero-loop.mp4"
    heroPoster:   "",   // optional still image shown before the video loads
    recapVideo:   "https://static1.squarespace.com/static/698ac8797f3cb35b8bf437d6/t/6aec5860a1ae126d9f813d8d/1793874025995/fm26-recap-bg.mp4",   // muted background loop MP4 URL — upload fm26-recap-bg.mp4 to Squarespace and paste its URL here
    photos: [
      /* leave empty to use the 14 event photos built into the page */
    ],
    logos: [ /* leave empty to use the 2026 partner logos built into the page */ ],
    sponsorUrl:   "https://www.futuremode.xyz/sponsorship-inquiry",   // where all partner / sponsor buttons go
    partnerEmail: "",   // optional: used only if sponsorUrl is empty
    instagram:    "https://www.instagram.com/futuremode_official/",   // main button
    socials: [
      { name: "Telegram", url: "https://t.me/taipeiblockchainweekofficial/1" },
      { name: "X",        url: "https://x.com/TaipeiWeek" },
      { name: "LinkedIn", url: "https://www.linkedin.com/company/91435987/" }
    ]
  };
  /* ======================================================= */

  var root = document.getElementById('fmh'); if(!root) return;


  /* Hero 3D grid: cells pop up from different corners */
  (function(){
    var plane=document.getElementById('fmh-grid'); if(!plane) return;
    var mob=window.matchMedia('(max-width:600px)').matches, C=mob?8:14, R=mob?7:9, cells=[];
    for(var k=0;k<C*R;k++){var c=document.createElement('div');c.className='hg-c';c.appendChild(document.createElement('i'));plane.appendChild(c);cells.push(c);}
    var colors=['','','','c-f','c-p','c-b'];
    function pop(){
      var corner=Math.floor(Math.random()*4), w=Math.ceil(C/3), hh=Math.ceil(R/2.5);
      var x=Math.floor(Math.random()*w), y=Math.floor(Math.random()*hh);
      if(corner&1) x=C-1-x; if(corner&2) y=R-1-y;
      var cell=cells[y*C+x]; if(!cell||cell.classList.contains('up')) return;
      var col=colors[Math.floor(Math.random()*colors.length)]; if(col) cell.classList.add(col);
      cell.classList.add('up');
      setTimeout(function(){cell.classList.remove('up');setTimeout(function(){if(col)cell.classList.remove(col);},1600);},2400+Math.random()*1800);
    }
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){for(var s=0;s<5;s++)pop();return;}
    var timer=null;
    function start(){if(!timer){pop();pop();timer=setInterval(function(){pop(); if(Math.random()<.5)pop();},650);}}
    function stop(){clearInterval(timer);timer=null;}
    if('IntersectionObserver' in window){new IntersectionObserver(function(e){e[0].isIntersecting?start():stop();}).observe(plane.parentNode);} else start();
  })();


  /* Twinkling stars on the stage lights (stats background) */
  (function(){
    var box=document.getElementById('fmh-stars'), photo=box&&box.previousElementSibling; if(!box) return;
    var IW=1999, IH=1333, PX=.12, PY=.70; // image size + background-position (12% 70%)
    var lights=[[862,200,30],[978,240,18],[1072,248,26],[1160,272,16],[1245,288,22],[1310,312,14],[1402,322,20],[1470,343,13],[1550,355,18],[1605,372,12],[1675,380,15],
                [752,65,14],[1040,140,12],[1305,210,12],[1522,268,11],[1700,312,10],[1855,350,10]];
    var stars=lights.map(function(l,i){var s=document.createElement('span');s.className='star';s.innerHTML='<i></i>';
      s.style.setProperty('--dl',(Math.random()*3).toFixed(2)+'s');s.style.setProperty('--t',(2.2+Math.random()*2.4).toFixed(2)+'s');box.appendChild(s);return s;});
    function place(){
      var W=box.offsetWidth, H=box.offsetHeight; if(!W||!H) return;
      var sc=Math.max(W/IW,H/IH), dw=IW*sc, dh=IH*sc, ox=(W-dw)*PX, oy=(H-dh)*PY;
      stars.forEach(function(s,i){var l=lights[i]; s.style.left=(ox+l[0]*sc)+'px'; s.style.top=(oy+l[1]*sc)+'px'; s.style.setProperty('--s',Math.max(8,l[2]*sc*1.6)+'px');});
    }
    place(); window.addEventListener('resize',place);
  })();

  /* Hero video */
  var bg = document.getElementById('fmh-hero-bg');
  if (FM_CONFIG.heroVideo) {
    var v = document.createElement('video');
    v.muted = true; v.loop = true; v.autoplay = true; v.playsInline = true;
    v.setAttribute('muted',''); v.setAttribute('playsinline','');
    if (FM_CONFIG.heroPoster) v.poster = FM_CONFIG.heroPoster;
    v.src = FM_CONFIG.heroVideo; bg.appendChild(v);
    var p = v.play(); if (p && p.catch) p.catch(function(){});
  } else if (FM_CONFIG.heroPoster) {
    bg.style.background = 'url("'+FM_CONFIG.heroPoster+'") center/cover';
  }

  /* Recap background video: restarts + plays when scrolled into view */
  var rv = document.getElementById('fmh-recap-vid');
  if (rv) {
    if (FM_CONFIG.recapVideo && rv.getAttribute('src') !== FM_CONFIG.recapVideo) rv.src = FM_CONFIG.recapVideo;
    rv.muted = true; rv.defaultMuted = true; rv.playsInline = true;
    var rvSeen = false;
    function rvPlay(){ var q = rv.play(); if (q && q.catch) q.catch(function(){ /* retry on next user gesture */ 
      var go = function(){ rv.play().catch(function(){}); window.removeEventListener('touchstart',go); window.removeEventListener('click',go); window.removeEventListener('scroll',go); };
      window.addEventListener('touchstart',go,{passive:true}); window.addEventListener('click',go); window.addEventListener('scroll',go,{passive:true}); }); }
    function inView(){ var r = rv.getBoundingClientRect(), vh = window.innerHeight || document.documentElement.clientHeight; return r.top < vh*0.7 && r.bottom > vh*0.3; }
    function check(){ if (inView()) { if (!rvSeen) { rvSeen = true; try{ rv.currentTime = 0; }catch(x){} } if (rv.paused) rvPlay(); } else { rvSeen = false; if (!rv.paused) rv.pause(); } }
    window.addEventListener('scroll', check, {passive:true}); window.addEventListener('resize', check);
    rv.addEventListener('loadeddata', check); setTimeout(check, 300); check();
  }

  /* Gallery: built-in photos unless FM_CONFIG.photos is filled */
  var gal = document.getElementById('fmh-gallery'), photos = FM_CONFIG.photos;
  if (photos.length) gal.innerHTML = photos.map(function(u,i){ return '<figure class="g rv'+(i===0?' big':'')+'"><img loading="lazy" src="'+u+'" alt="FUTUREMODE 2026 event photo '+(i+1)+'"></figure>'; }).join('');

  /* Logos */
  var lg = document.getElementById('fmh-logos'), logos = FM_CONFIG.logos, ln = logos.length, lh = '';
  if (ln) {
  for (var j=0;j<ln;j++){
    lh += logos[j]
      ? '<div class="logo"><img loading="lazy" src="'+logos[j].src+'" alt="'+(logos[j].name||'Partner')+'"></div>'
      : '<div class="logo"><span class="ph-t">Logo</span></div>';
  }
  lg.innerHTML = '<div class="logos" style="margin-top:48px">'+lh+'</div>'; }

  /* Partner links */
  function mail(subject){ if (FM_CONFIG.sponsorUrl) return FM_CONFIG.sponsorUrl; return FM_CONFIG.partnerEmail ? 'mailto:'+FM_CONFIG.partnerEmail+'?subject='+encodeURIComponent(subject) : '#fmh-partner'; }
  root.querySelectorAll('.p-card').forEach(function(c){ c.href = mail(c.getAttribute('data-subject')); });
  document.getElementById('fmh-cta-main').href = mail('FUTUREMODE 2027 – Partnership inquiry');

  /* Telegram + socials */
  /* Every external button/link opens in a new tab */
  function newTabs(){ root.querySelectorAll('a[href]').forEach(function(a){
    var u = a.getAttribute('href'); if (!u || u.charAt(0) === '#') return;
    a.setAttribute('target','_blank'); a.setAttribute('rel','noopener'); }); }
  var ig = document.getElementById('fmh-ig');
  if (FM_CONFIG.instagram) ig.href = FM_CONFIG.instagram;
  document.getElementById('fmh-cta-hero').href = FM_CONFIG.sponsorUrl || '#fmh-partner';
  document.getElementById('fmh-socials').innerHTML = FM_CONFIG.socials.map(function(s){
    return '<a class="soc" '+(s.url?'href="'+s.url+'" target="_blank" rel="noopener"':'')+'>'+s.name+' ↗</a>';
  }).join('');

  newTabs();

  /* Smooth scroll for in-page links (Squarespace-safe) */
  root.querySelectorAll('a[href^="#fmh-"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var t = document.getElementById(a.getAttribute('href').slice(1));
      if (t){ e.preventDefault(); t.scrollIntoView({behavior:'smooth', block:'start'}); }
    });
  });

  /* Count-up + reveal.
     Anything already on screen when the script starts is shown as-is (no fade, no recount),
     so there is no flash. Only sections scrolled to later animate. */
  function countUp(el){
    var end = +el.getAttribute('data-count'), suf = el.getAttribute('data-suffix')||'', t0 = null, dur = 1400;
    el.textContent = '0'+suf;
    function step(ts){ if(!t0) t0 = ts; var k = Math.min((ts-t0)/dur,1), e = 1-Math.pow(1-k,3);
      el.textContent = Math.round(end*e).toLocaleString('en-US')+suf; if(k<1) requestAnimationFrame(step); }
    requestAnimationFrame(step);
  }
  function bars(el, w0){ el.querySelectorAll('.bar i').forEach(function(b){
    if (w0) { b.style.width = '0'; void b.offsetWidth; }
    b.style.width = b.getAttribute('data-w')+'%'; }); }
  var reveal = root.querySelectorAll('.rv'), vh = window.innerHeight || document.documentElement.clientHeight;
  if (!('IntersectionObserver' in window)) { bars(root,false); return; }
  root.classList.add('fmh-js');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(!en.isIntersecting) return; var el = en.target;
      el.querySelectorAll('[data-count]').forEach(countUp);
      bars(el,true);
      el.classList.add('in');
      io.unobserve(el);
    });
  }, {threshold:.15});
  reveal.forEach(function(r){
    var b = r.getBoundingClientRect();
    if (b.top < vh && b.bottom > 0) { r.classList.add('now','in'); bars(r,false); }   // already visible: show immediately
    else { r.querySelectorAll('.bar i').forEach(function(i){ i.style.width='0'; }); io.observe(r); }
  });
})();
</script>
  
  



