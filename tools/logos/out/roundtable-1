<script>
  async function fetchTweets() {
    const rssUrl = 'https://rss.app/feeds/MxNimDyr5e3qN1Z7.xml'; // RSS feed URL

    try {
      const response = await fetch(rssUrl);
      const text = await response.text();
      console.log('RSS Feed Response:', text); // Debugging: Log the raw RSS feed

      const parser = new DOMParser();
      const xml = parser.parseFromString(text, 'application/xml');
      const items = xml.querySelectorAll('item > title'); // Adjust the query if needed

      if (items.length === 0) {
        console.log('No items found in RSS feed.'); // Debugging: Log if no items are found
      }

      const livefeedFetch = document.querySelector('.livefeed_fetch');

      if (items.length > 0) {
        const marqueeContainer = document.createElement('div');
        marqueeContainer.className = 'marquee-container';

        // Append each tweet to the container
        items.forEach(item => {
          const tweetText = item.textContent;

          const tweetSpan = document.createElement('span');
          tweetSpan.className = 'tweet';
          tweetSpan.textContent = tweetText;

          marqueeContainer.appendChild(tweetSpan);
        });

        // Clone the container to ensure continuous scrolling
        const marqueeWrapper = document.createElement('div');
        marqueeWrapper.className = 'marquee-wrapper';

        marqueeWrapper.appendChild(marqueeContainer.cloneNode(true));
        marqueeWrapper.appendChild(marqueeContainer);

        livefeedFetch.innerHTML = '';
        livefeedFetch.appendChild(marqueeWrapper);

        // Adjust marquee speed based on screen size
        adjustMarqueeSpeed();
        window.addEventListener('resize', adjustMarqueeSpeed);
      }

    } catch (error) {
      console.error('Error fetching tweets:', error);
    }
  }

  // Adjust marquee speed dynamically based on screen size
  function adjustMarqueeSpeed() {
    const marqueeContainer = document.querySelector('.marquee-container');
    if (marqueeContainer) {
      const isMobile = window.innerWidth <= 768;
      marqueeContainer.style.animationDuration = isMobile ? '1000s' : '600s';
    }
  }

  // Call the function to fetch and display tweets
  fetchTweets();
</script>

