<script>
function InteractiveParticles(canvas, args) {
  var that = this;
  this.canvas = canvas;
  this.args = args;
  this.density = 34;
  this.baseRadius = 4.377;
  this.canvasPadding = 30;
  this.ignoreColors = [];
  this.particles = [];
  this.context = null;
  this.bgImage = null;
  this.bgCanvas = null;
  this.bgContext = null;
  this.bgContextPixelData = null;

  for (var key in args) {
    this[key] = args[key];
  }

  this.add = function() {
    that.context = that.canvas.getContext('2d', { alpha: true });

    // Set canvas dimensions based on container's size
    that.updateCanvasDimensions();

    that.canvas.style.display = 'block';

    // Apply cross-browser CSS styling using JS
    that.applyCanvasStyles();

    window.addEventListener('resize', function() {
      that.updateCanvasDimensions();
      that.onWindowResize();
    });

    that.getImageData(that.image);
  };

  this.updateCanvasDimensions = function() {
    that.canvas.width = that.canvas.clientWidth * 1.5 + (that.canvasPadding * 2);
    that.canvas.height = that.canvas.clientHeight * 1.5 + (that.canvasPadding * 2);
  };

  this.applyCanvasStyles = function() {
    that.canvas.style.filter = 'blur(0px) contrast(1.8) brightness(1.8)';
    that.canvas.style.opacity = '0.7';
  };

  this.makeParticles = function() {
    that.particles = [];
    var i, j;
    var colors = that.bgContextPixelData.data;

    for (i = 0; i < that.canvas.height; i += that.density) {
      for (j = 0; j < that.canvas.width; j += that.density) {
        var pixelPosition = (j + i * that.bgContextPixelData.width) * 4;

        var ignoreColor = false;
        if (that.ignoreColors.length) {
          for (var ckey in that.ignoreColors) {
            if (colors[pixelPosition] == that.ignoreColors[ckey][0] &&
              (colors[pixelPosition + 1]) == that.ignoreColors[ckey][1] &&
              (colors[pixelPosition + 2]) == that.ignoreColors[ckey][2]) {
              ignoreColor = true;
            }
          }
          if (ignoreColor) continue;
        }

        var brightness = (0.299 * colors[pixelPosition] + 0.587 * colors[pixelPosition + 1] + 0.114 * colors[pixelPosition + 2]) / 255;
        var lineWidth = Math.max(1, that.baseRadius * brightness);

        var color = 'rgba(' + colors[pixelPosition] + ',' + colors[pixelPosition + 1] + ',' + colors[pixelPosition + 2] + ',1)';
        that.particles.push({
          x: j,
          y: i,
          originalX: j,
          originalY: i,
          color: color,
          lineWidth: lineWidth,
          baseLineWidth: lineWidth
        });
      }
    }
  };

  this.produceParticles = function() {
    var i, currentPoint;

    for (i = 0; i < that.particles.length; i++) {
      currentPoint = that.particles[i];

      that.context.strokeStyle = currentPoint.color;
      that.context.lineWidth = currentPoint.lineWidth;

      that.context.beginPath();
      that.context.moveTo(currentPoint.x, currentPoint.y);
      that.context.lineTo(currentPoint.x, currentPoint.y + that.density); // Draw vertically
      that.context.stroke();
    }
  };

  this.produce = function() {
    that.animation = requestAnimationFrame(function() {
      that.produce();
    });

    that.remove();
    that.produceParticles();
  };

  this.remove = function() {
    that.canvas.width = that.canvas.width;
  };

  this.getImageData = function(data) {
    that.bgImage = new Image();
    that.bgImage.crossOrigin = "Anonymous";
    that.bgImage.src = "https://cdn.prod.website-files.com/669db037ed7cd8641325cad6/66a01da1ec27ddb076e1842e_Pic_Poster_Grayscale06.webp";

    that.bgImage.onload = function() {
      that.produceInteractiveParticles();
    };
  };

  this.produceInteractiveParticles = function() {
    that.bgCanvas = document.createElement('canvas');
    that.bgCanvas.width = that.canvas.width;
    that.bgCanvas.height = that.canvas.height;

    var imageAspectRatio = that.bgImage.width / that.bgImage.height;
    var canvasAspectRatio = that.canvas.width / that.canvas.height;

    var newWidth, newHeight;

    if (canvasAspectRatio > imageAspectRatio) {
      // Fit to height
      newHeight = that.canvas.height;
      newWidth = newHeight * imageAspectRatio;
    } else {
      // Fit to width
      newWidth = that.canvas.width;
      newHeight = newWidth / imageAspectRatio;
    }

    that.bgContext = that.bgCanvas.getContext('2d', { alpha: false });
    that.bgContext.drawImage(that.bgImage, (that.canvas.width - newWidth) / 2, (that.canvas.height - newHeight) / 2, newWidth, newHeight);
    that.bgContextPixelData = that.bgContext.getImageData(0, 0, that.bgCanvas.width, that.bgCanvas.height);

    that.makeParticles();
    that.produce();
  };

  this.onWindowResize = function() {
    cancelAnimationFrame(that.animation);
    that.produceInteractiveParticles();
  };

  this.add(this.canvas, this.args);
}

