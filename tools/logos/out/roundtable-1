    }
  });

  cell.addEventListener('mouseleave', () => {
    if (!cell.classList.contains('clicked')) {
      setTimeout(() => {
        cell.classList.remove('hovered');
      }, 300); // Adjust delay as needed
    }
  });

  // Handle click
  cell.addEventListener('click', () => {
    if (cell.classList.contains('clicked')) {
      // If already clicked, remove the clicked state
      cell.classList.remove('clicked', 'hovered');
    } else {
      // If not clicked, set it to clicked state
      cell.classList.add('clicked');
      cell.classList.remove('hovered'); // Ensure hover state doesn't interfere
    }
  });
});

